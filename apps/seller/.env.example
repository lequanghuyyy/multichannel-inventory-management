# Public build-time setting, NOT a secret. Every VITE_* value is bundled into the app.
# Web development: leave empty to use Vite's /api and /health proxy.
# Packaged Android/iOS: use an HTTPS backend reachable from that device.
# Rebuild + cap sync after changing the address. Do not add passwords, tokens, API keys, or private keys.
VITE_API_URL=
